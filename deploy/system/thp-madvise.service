[Unit]
Description=Set transparent hugepage policy to madvise (avoid Go/new-api RSS bloat)
Documentation=see /opt/new-api-migrated/PROGRESS.md 2026-08-05
After=sysinit.target local-fs.target
Before=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'echo madvise > /sys/kernel/mm/transparent_hugepage/enabled'

[Install]
WantedBy=multi-user.target
